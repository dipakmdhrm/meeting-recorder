[*.{kt,kts}]
# Match the Android Studio default style the codebase is written in.
ktlint_code_style = intellij_idea

# @Composable functions are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Decision-helper files (RecordingStopDecision.kt, GenerateActionDecision.kt)
# are named after the decision they encode, not the enum they contain — an
# established repo pattern documented in CLAUDE.md.
ktlint_standard_filename = disabled
